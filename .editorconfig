# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{js,mjs,css,html,json,md,yml,yaml,toml}]
indent_size = 2

[*.md]
# Trailing double spaces are meaningful line breaks in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[Cargo.toml]
indent_size = 4
